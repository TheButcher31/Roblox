local VenyxLibrary = loadstring(game:HttpGet("https://raw.githubusercontent.com/Documantation12/Universal-Vehicle-Script/main/Library.lua"))()
local Venyx = VenyxLibrary.new("Cenaze Dernegi Universal", 5013109572)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local Theme = {
    Background = Color3.new(0.129412, 0.129412, 0.129412), 
    Glow = Color3.new(0.000000, 0.000000, 0.000000), 
    Accent = Color3.new(0.101961, 0.101961, 0.101961), 
    LightContrast = Color3.new(0.133333, 0.125490, 0.125490), 
